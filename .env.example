# Provedor de IA usado em main.py: 'gemini' ou 'nova'
# (o compare.py sempre executa os dois, independente desta opção)
AI_PROVIDER=gemini

# --- Google Gemini ---
# Obtenha sua chave em: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=sua_chave_api_aqui
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Amazon Bedrock (Nova Lite) ---
# Habilite o acesso ao modelo Nova Lite em: Bedrock -> Model access.
AWS_REGION=us-east-1
NOVA_MODEL_ID=us.amazon.nova-lite-v1:0

# Autenticação (escolha UMA opção):
#
# Opção A (recomendada) - API key do Bedrock (token único, mais simples).
# Gere em: Console AWS -> Bedrock -> API keys -> Generate long-term API key.
AWS_BEARER_TOKEN_BEDROCK=sua_api_key_do_bedrock
#
# Opção B - par de credenciais IAM (ou use `aws configure` / ~/.aws/credentials).
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
